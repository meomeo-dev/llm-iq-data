{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-iq.dev/schemas/day-index.schema.json",
  "title": "DayIndex",
  "description": "公开数据仓日索引结构规范",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^\\d{8}T\\d{6}Z$"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "schedule",
              "manual"
            ]
          },
          "promptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "ok": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "pattern": "^runs/\\d{4}/\\d{2}/\\d{2}/\\d{8}T\\d{6}Z$"
          }
        },
        "required": [
          "runId",
          "startedAt",
          "finishedAt",
          "trigger",
          "promptIds",
          "attempts",
          "ok",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "runs"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-iq.dev/schemas/manifest.schema.json",
  "title": "DataRepoManifest",
  "description": "公开数据仓顶层清单结构规范",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalRuns": {
      "type": "integer",
      "minimum": 0
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "pattern": "^runs/\\d{4}/\\d{2}/\\d{2}$"
          }
        },
        "required": [
          "date",
          "runs",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "description",
    "repository",
    "updatedAt",
    "totalRuns",
    "days"
  ],
  "additionalProperties": false
}
